{
  "name": "trading-dashboard",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/trading-dashboard",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/trading-dashboard,type=bind,consistency=cached",
  "forwardPorts": [5432, 6379, 8000, 3000],
  "postCreateCommand": "bash -lc 'python3 -m venv .venv && source .venv/bin/activate && pip install --upgrade pip && pre-commit install && corepack enable'",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
